# Copy this file to .env and fill in your own keys.
# Never commit your real .env file.

# Free — https://www.pinecone.io (Starter/free plan: 2GB storage, no card needed)
PINECONE_API_KEY="your-pinecone-api-key"

# Free — https://console.groq.com/keys (no credit card, no expiry)
GROQ_API_KEY="your-groq-api-key"

# Free — Neon (neon.tech) has an always-free Postgres plan (0.5GB storage,
# no credit card, no expiry). Create a project, then copy the connection
# string it gives you directly from the dashboard -- it already includes
# sslmode=require, no reassembly needed. Format looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Any standard Postgres 12+ server works too, including one running locally.
DATABASE_URL="your-neon-connection-string"

# --- Optional: only needed for the split multi-service deployment ---
# See DEPLOYMENT.md. Leave all three of these unset/commented out for the
# simple single-service deployment (or local dev) -- everything below is
# 100% opt-in and the app's default behavior is unchanged without it.

# Set this to the URL of a separately-deployed inference_service/ (e.g.
# https://your-inference-service.onrender.com) to load the embedding and
# reranker models there instead of in this app's own process. This is
# what makes the two-free-instance split actually save RAM -- see
# inference_service/app.py and src/helper.py.
# EMBEDDING_SERVICE_URL="https://your-inference-service.onrender.com"

# A shared secret between this app and inference_service/, so the
# service's public URL can't be used by anyone who happens to find it.
# Only takes effect if you also set the *same* value in
# inference_service/'s own environment. Any random string works --
# e.g. generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INFERENCE_SERVICE_TOKEN="a-long-random-shared-secret"

# Comma-separated list of origins allowed to call this API cross-origin.
# Only needed if the frontend (templates/chat.html + static/app.jsx) is
# deployed separately from this API, e.g. as a static site on Netlify or
# Vercel, instead of being served by this same Flask app.
# ALLOWED_ORIGINS="https://your-frontend.netlify.app"
